# Application root directory (defaults to repo/install dir)
CLIWS_APP_DIR=/opt/cliws

# Server bind
CLIWS_HOST=0.0.0.0
CLIWS_PORT=443

# TLS certificate paths (generated by install.sh)
CLIWS_SSL_CERTFILE=/opt/cliws/certs/cliws.crt
CLIWS_SSL_KEYFILE=/opt/cliws/certs/cliws.key

# Optional HTTP redirect port (0 = disabled)
CLIWS_HTTP_REDIRECT_PORT=0

# Shell used to execute commands
CLIWS_SHELL=/bin/bash

# SQLite database path (relative to CLIWS_APP_DIR unless absolute)
CLIWS_DB_PATH=data/cliws.db

# Expected schema version (must match sql migrations)
CLIWS_SCHEMA_VERSION=2

# Run retention after last client disconnects (seconds)
CLIWS_RUN_RETENTION_SECONDS=300

# Logging
CLIWS_LOG_LEVEL=INFO
CLIWS_LOG_DIR=logs
