[Unit]
Description=CLIWS curated command dashboard
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory={{INSTALL_DIR}}
EnvironmentFile={{INSTALL_DIR}}/.env
ExecStart={{INSTALL_DIR}}/.venv/bin/uvicorn backend.main:app --host {{CLIWS_HOST}} --port {{CLIWS_PORT}} --ssl-certfile {{CLIWS_SSL_CERTFILE}} --ssl-keyfile {{CLIWS_SSL_KEYFILE}}
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
